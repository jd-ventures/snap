{
  "name": "snap-extension",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch & vite build -c vite.content.config.ts --watch",
    "build": "tsc --noEmit && vite build && vite build -c vite.content.config.ts",
    "icons": "node scripts/icons.mjs",
    "check": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
